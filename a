7. Chart: platform (wrapper over the official Dagster chart)

7.1 charts/platform/Chart.yaml

apiVersion: v2
name: platform
version: 1.0.0
dependencies:
  - name: dagster
    version: "1.13.5"          # MUST equal the pin in shared/uv.lock
    repository: https://dagster-io.github.io/helm


7.2 charts/platform/values/values-prod.yaml

dagster:
  dagster-user-deployments:
    enabled: false             # locations are managed by AppSet #2, not here

  dagsterWebserver:
    workspace:
      enabled: true
      externalConfigmap: dagster-workspace   # the §6 contract
    annotations:
      # Restart webserver when the workspace CM changes (stakater reloader).
      # Without this, new locations don't appear until manual restart.
      configmap.reloader.stakater.com/reload: "dagster-workspace"
    resources:
      requests: { cpu: 500m, memory: 1Gi }

  dagsterDaemon:
    annotations:
      configmap.reloader.stakater.com/reload: "dagster-workspace"
    runCoordinator:
      enabled: true
      type: QueuedRunCoordinator
      config:
        queuedRunCoordinator:
          maxConcurrentRuns: 20
          tagConcurrencyLimits:
            - key: dagster/code-location
              limit: 5
              value: { applyLimitPerUniqueValue: true }

  runLauncher:
    type: K8sRunLauncher
    config:
      k8sRunLauncher:
        loadInclusterConfig: true
        jobNamespace: dagster-prod
        # envSecrets here apply to ALL run pods (e.g. the pg secret):
        envSecrets:
          - name: dagster-postgresql-secret

  postgresql:
    enabled: false             # RDS, never in-cluster for prod
    postgresqlHost: aiops-dagster-prod.xxxx.us-west-2.rds.amazonaws.com
    postgresqlUsername: dagster
    postgresqlDatabase: dagster
    service: { port: 5432 }
  generatePostgresqlPasswordSecret: false
  global:
    postgresqlSecretName: dagster-postgresql-secret   # via ExternalSecret

  computeLogManager:
    type: S3ComputeLogManager
    config:
      s3ComputeLogManager:
        bucket: srca-aiops-dagster-prod
        prefix: compute-logs
        region: us-west-2
        skipEmptyFiles: true

  migrate:
    enabled: false             # flip to true ONLY during version upgrades


dagster.yaml is now 100% Helm-rendered. You never edit it by hand; you edit values and let Argo sync.
