5.3 charts/code-location/templates/_helpers.tpl

{{/*
Container context propagated to run pods. This is the OSS mechanism the
official chart uses under includeConfigInLaunchedRuns: the K8sRunLauncher
reads DAGSTER_CLI_API_GRPC_CONTAINER_CONTEXT from the code server and
applies env_config_maps / env_secrets / run_k8s_config to every run pod
launched for this location. Without this, run pods get NO project env.
*/}}
{{- define "codeLocation.containerContext" -}}
{{- $secrets := list -}}
{{- if .Values.secrets.enabled -}}
{{- $secrets = list (printf "%s-secrets" .Values.locationName) -}}
{{- end -}}
{{- $k8s := dict
      "namespace" .Release.Namespace
      "service_account_name" .Values.serviceAccount
      "env_config_maps" (list (printf "%s-env" .Values.locationName))
      "env_secrets" $secrets
      "run_k8s_config" (.Values.runK8sConfig | default dict)
-}}
{{- dict "k8s" $k8s | toJson -}}
{{- end -}}


5.4 charts/code-location/templates/deployment.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Values.locationName }}-code
  labels:
    app.kubernetes.io/name: dagster-code-location
    app.kubernetes.io/instance: {{ .Values.locationName }}
spec:
  replicas: {{ .Values.codeServer.replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ .Values.locationName }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: dagster-code-location
        app.kubernetes.io/instance: {{ .Values.locationName }}
      annotations:
        # Roll the pod when project env changes — otherwise stale config
        checksum/env: {{ include (print $.Template.BasePath "/configmap.yaml") . | sha256sum }}
    spec:
      serviceAccountName: {{ .Values.serviceAccount }}
      containers:
        - name: grpc
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ .Values.codeServer.port }}
          env:
            # Run pods use THIS image. Without it, K8sRunLauncher fails.
            - name: DAGSTER_CURRENT_IMAGE
              value: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
            - name: DAGSTER_CLI_API_GRPC_CONTAINER_CONTEXT
              value: {{ include "codeLocation.containerContext" . | quote }}
          envFrom:
            - configMapRef:
                name: {{ .Values.locationName }}-env
            {{- if .Values.secrets.enabled }}
            - secretRef:
                name: {{ .Values.locationName }}-secrets
            {{- end }}
          readinessProbe:
            exec:
              command: ["dagster", "api", "grpc-health-check",
                        "-p", "{{ .Values.codeServer.port }}"]
            initialDelaySeconds: 10
            periodSeconds: 20
            timeoutSeconds: 10
          livenessProbe:
            tcpSocket:
              port: {{ .Values.codeServer.port }}
            initialDelaySeconds: 30
            periodSeconds: 30
          resources:
            {{- toYaml .Values.codeServer.resources | nindent 12 }}


