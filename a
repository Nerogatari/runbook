9. CI — path-filtered matrix builds

.github/workflows/build-images.yaml:

name: build-images
on:
  push:
    branches: [main]
    paths: ["projects/**", "libs/**"]

jobs:
  detect:
    runs-on: ubuntu-latest
    outputs:
      projects: ${{ steps.diff.outputs.projects }}
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 2 }
      - id: diff
        run: |
          CHANGED=$(git diff --name-only HEAD~1 HEAD)
          if echo "$CHANGED" | grep -q '^libs/'; then
            # shared lib changed → rebuild everything on the same pin
            PROJECTS=$(ls -d projects/*/ | xargs -n1 basename)
          else
            PROJECTS=$(echo "$CHANGED" | grep '^projects/' \
                       | cut -d/ -f2 | sort -u)
          fi
          echo "projects=$(echo $PROJECTS | jq -R 'split(" ")' -c)" >> "$GITHUB_OUTPUT"

  build:
    needs: detect
    if: needs.detect.outputs.projects != '[]'
    runs-on: ubuntu-latest
    strategy:
      matrix:
        project: ${{ fromJson(needs.detect.outputs.projects) }}
    permissions: { id-token: write, contents: read }
    steps:
      - uses: actions/checkout@v4
      - name: Validate lockfile is in sync
        run: |
          pip install uv
          cd projects/${{ matrix.project }} && uv lock --check
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::123456789012:role/gha-ecr-push
          aws-region: us-west-2
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Build and push
        run: |
          IMG=123456789012.dkr.ecr.us-west-2.amazonaws.com/dagster/${{ matrix.project }}
          TAG=git-${GITHUB_SHA::7}
          docker build -f projects/${{ matrix.project }}/Dockerfile \
            -t $IMG:$TAG .
          docker push $IMG:$TAG


CI only builds and pushes. It never edits values files — tag propagation is Kargo's job. This separation is what keeps rollbacks a one-line git revert.
